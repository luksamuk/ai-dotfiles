{
  "defaultModel": "ornith-1.5-35b-heretic:think",
  "defaultProvider": "llama-swap",
  "lastChangelogVersion": "1.4.0",
  "packages": [
    "npm:pi-acp",
    "npm:@alasano/pi-linear",
    "npm:pi-llama-cpp",
    "npm:@billjr99/pi-openai-compat"
  ],
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "httpIdleTimeoutMs": 0,
  "theme": "dark",
  "extensions": [
    "-builtin:llama.cpp"
  ],
  "llamaSettings": {
    "servers": [
      {
        "url": "http://127.0.0.1:12434",
        "id": "llama-swap",
        "name": "Frota Navi"
      }
    ],
    "reactToModelSelect": true,
    "autoloadOnMessage": true,
    "sortBy": "asc"
  }
}