{
  "ui_font_size": 14.0,
  "buffer_font_size": 13.0,
  "ui_font_family": ".ZedSans",
  "agent_buffer_font_size": 13.0,
  "agent_ui_font_size": 15.0,
  "terminal": {
    "font_size": 13.0
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^ls\\b"
            }
          ]
        }
      }
    },
    "default_model": {
      "provider": "llama-swap",
      "model": "ornith-1.5-35b:think",
      "enable_thinking": false
    },
    "favorite_models": [
      {
        "model": "bonsai-27b:think",
        "provider": "llama-swap"
      },
      {
        "provider": "llama-swap",
        "model": "ornith-1.5-35b:think",
        "enable_thinking": false
      },
      {
        "provider": "ollama",
        "model": "glm-5.2:cloud",
        "enable_thinking": true
      },
      {
        "provider": "ollama",
        "model": "kimi-k2.7-code:cloud",
        "enable_thinking": true
      },
      {
        "provider": "ollama",
        "model": "minimax-m3:cloud",
        "enable_thinking": true
      }
    ],
    "model_parameters": []
  },
  "context_servers": {
    "duckduckgo": {
      "command": "uvx",
      "args": [
        "duckduckgo-mcp-server"
      ]
    },
    "searxng": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-searxng"
      ],
      "env": {
        "SEARXNG_URL": "http://192.168.3.8:8888"
      }
    },
    "linear": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ]
    }
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "base_keymap": "Emacs",
  "icon_theme": "Zed (Default)",
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Catppuccin Macchiato"
  },
  "language_models": {
    "openai_compatible": {
      "llama-swap": {
        "api_url": "http://127.0.0.1:12434/v1",
        "available_models": [
          {
            "name": "ornith-1.5-35b",
            "display_name": "Ornith 1.5 35B",
            "max_tokens": 131072,
            "supports_thinking": false
          },
          {
            "name": "ornith-1.5-35b:think",
            "display_name": "Ornith 1.5 35B (Thinking)",
            "max_tokens": 131072,
            "supports_thinking": true
          },
          {
            "name": "bonsai-27b",
            "display_name": "Bonsai 27B (1-bit)",
            "max_tokens": 131072,
            "supports_thinking": false
          },
          {
            "name": "bonsai-27b:think",
            "display_name": "Bonsai 27B (Thinking)",
            "max_tokens": 131072,
