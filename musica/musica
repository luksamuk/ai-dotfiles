#!/bin/bash
# musica — gerador de música local, AGNÓSTICO DE MODELO (audio.cpp)
#
# Irmão do `diffuse` (imagem) e do `h3` (vídeo). Um binário, várias famílias.
# O modelo se escolhe por --modelo; o resto da interface é igual.
#
# Uso:
#   musica --letra-file L.txt --legenda-file C.txt --modelo ace --dur 30
#   musica --letra-file L.txt --legenda "MPB 1979, violao de nylon" --modelo ace
#   musica --letra-file L.txt --legenda-file C.txt --modelo ace --seed 7 --bpm 140
#   musica --instrumental --legenda-file C.txt --modelo stable --dur 30
#   musica list                                       # famílias + instalado + tamanho
#   musica --dry-run ...                              # mostra o comando e encerra
#
# AVISO OPERACIONAL: rode via `tu run`, NUNCA em terminal background puro.
# Background + unified memory = morte silenciosa (5/5 reproduções).

set -o pipefail

# ---------- caminhos ----------
MUSICA_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
AUDIOCPP_HOME="${AUDIOCPP_HOME:-$HOME/git/audio.cpp}"
BIN="$AUDIOCPP_HOME/build/linux-cuda-release/bin/audiocpp_cli"
OUT_DIR="${MUSICA_OUT_DIR:-$PWD}"
# Override de model_specs é OBRIGATÓRIO para ace_step (o spec stock do upstream
# exige dit_base_* que não existe no repo oficial). Default: specs/ versionado
# junto do wrapper; MUSICA_SPECS sobrepõe.
SPECS_OVERRIDE="${MUSICA_SPECS:-$MUSICA_HOME/specs}"

# ---------- defaults ----------
MODELO="ace"
DUR=30
SEED=42
STEPS=""
GUIDANCE=""
LETRA=""
LETRA_FILE=""
LEGENDA=""
LEGENDA_FILE=""
BPM=""
TOM=""
COMPASSO=""
IDIOMA="pt"
INSTRUMENTAL=0
OUT=""
DRY_RUN=0
EXTRA=()

# ---------- tabela de famílias ----------
# formato: apelido|familia_audio.cpp|dir_relativo_debaixo_de AUDIOCPP_HOME|steps_default|usa_letra|descricao
familias() {
  cat <<'EOF'
ace|ace_step|models/Ace-Step1.5|8|sim|ACE-Step 1.5 (turbo) — controle simbólico (--bpm --tom --compasso), rota cover, MIT, ~31s por 30s de música
base|ace_step|models/Ace-Step1.5|50|sim|ACE-Step 1.5 (base, 50 steps) — mais qualidade, mais lento; mesma interface do ace
xl|ace_step|models/Ace-Step1.5-xl|8|sim|ACE-Step 1.5 XL (4B DiT) — exige ~12GB VRAM com offload; provavelmente não cabe em 6GB
stable|stable_audio|models/Stable-Audio-3-Small-Music-GGUF|8|nao|Stable Audio 3 Small — instrumentais, loops, ambiência, SFX; SEM letra (não pede --letra)
heart|heartmula|models/heartmula|8|sim|HeartMuLa OSS 3B — letra + tags, adesão à letra em nível de tag
EOF
}

resolver_familia() {
  local apelido="$1" linha
  while IFS='|' read -r l_apelido l_familia l_dir l_steps l_letra l_desc; do
    [ "$l_apelido" = "$apelido" ] && {
      FAMILIA="$l_familia"; MDIR_REL="$l_dir"
      VSTEPS="${STEPS:-$l_steps}"; USA_LETRA="$l_letra"
      return 0
    }
  done < <(familias)
  echo "modelo desconhecido: $apelido (use: musica list)" >&2
  exit 1
}

# ---------- lista / help ----------
musica_list() {
  local linha apelido dir desc instalado tam
  echo "Famílias de música no audio.cpp (escolha com --modelo):"
  echo
  while IFS='|' read -r apelido _fam dir _steps _letra desc; do
    if [ -d "$AUDIOCPP_HOME/$dir" ]; then
      instalado="INSTALADO"
      tam=$(du -sh "$AUDIOCPP_HOME/$dir" 2>/dev/null | cut -f1)
    else
      instalado="ausente"
      tam="-"
    fi
    printf '  %-7s %-9s %6s  %s\n' "$apelido" "$instalado" "$tam" "$desc"
    printf '          dir: %s\n' "$dir"
  done < <(familias)
  echo
  echo "Para instalar pesos de uma família leia o README (ai-dotfiles/musica/):"
  echo "  pesos oficiais via curl; o repo de pacotes audio-cpp/audio.cpp-gguf está"
  echo "  quebrado no CDN (~5 KB/s e 'conclui' com exit 0 sem baixar nada)."
}

uso() {
  cat <<'EOF'
musica — gerador de música local, agnóstico de modelo (wrapper do audio.cpp)

Uso:
  musica --modelo ace --letra-file L.txt --legenda-file C.txt --dur 30
  musica --modelo ace --letra "letra inline" --legenda "MPB 1979, violão de nylon"
  musica --instrumental --legenda-file C.txt --modelo ace --dur 60
  musica --instrumental --legenda "lo-fi, chuva, piano" --modelo stable --dur 30
  musica list                          # famílias: instalado/ausente + tamanho
  musica ... --dry-run                 # imprime o comando e encerra

Famílias (--modelo):
  ace      ACE-Step 1.5 turbo (default)  — letra + controle simbólico, cover
  base     ACE-Step 1.5 base             — 50 steps, mais qualidade
  xl       ACE-Step 1.5 XL 4B            — ~12GB VRAM, não cabe em 6GB
  stable   Stable Audio 3 Small          — instrumental/loops/SFX, SEM letra
  heart    HeartMuLa 3B                  — letra + tags
  (estado real em disco: `musica list`)

Flags:
  --modelo|-m NOME     família (default: ace)
  --letra TEXTO        letra inline (tags [Verse]/[Chorus] em linha própria)
  --letra-file PATH    letra de arquivo (sobrepõe --letra)
  --legenda TEXTO      descrição do som (inline)
  --legenda-file PATH  descrição do som de arquivo
  --dur N              duração alvo em segundos (default: 30)
  --seed N             semente reprodutível (default: 42)
  --steps N            passos de denoise (default por família: ace 8, base 50)
  --guidance N         guidance scale (familias que aceitam)
  --bpm/--tom/--compasso  controle simbólico (só ACE-Step; ex: --tom "D minor")
  --idioma LING        idioma do vocal (default: pt)
  --instrumental       sem voz (ace/heart: injeta [Instrumental]; stable: já é)
  --out|-o CAMINHO     arquivo WAV de saída
  --out-dir DIR        diretório de saída (default: $PWD; env MUSICA_OUT_DIR)
  --specs DIR          override de model_specs (env MUSICA_SPECS)
  --list/--lista       estado das famílias em disco
  --dry-run            valida e mostra o comando sem executar
  -h/--help            esta ajuda

Saída: WAV verificado com ffprobe ao final (o marcador de fim NÃO prova sucesso).

Regras operacionais (não negociáveis):
  - rodar via `tu run`, NUNCA em terminal background puro (morte silenciosa)
  - GGML_CUDA_ENABLE_UNIFIED_MEMORY=1 já exportado pelo wrapper (6GB VRAM)
  - antes de rodar, `llama-swap-cli unload` se houver LLM brigando pelos 6GB
EOF
  exit 0
}

# ---------- parse ----------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --modelo|-m)      MODELO="$2"; shift 2 ;;
    --letra)          LETRA="$2"; shift 2 ;;
    --letra-file)     LETRA_FILE="$2"; shift 2 ;;
    --legenda)        LEGENDA="$2"; shift 2 ;;
    --legenda-file)   LEGENDA_FILE="$2"; shift 2 ;;
    --dur|--duration) DUR="$2"; shift 2 ;;
    --seed)           SEED="$2"; shift 2 ;;
    --steps)          STEPS="$2"; shift 2 ;;
    --guidance)       GUIDANCE="$2"; shift 2 ;;
    --bpm)            BPM="$2"; shift 2 ;;
    --tom)            TOM="$2"; shift 2 ;;
    --compasso)       COMPASSO="$2"; shift 2 ;;
    --idioma)         IDIOMA="$2"; shift 2 ;;
    --instrumental)   INSTRUMENTAL=1; shift ;;
    --out|-o)         OUT="$2"; shift 2 ;;
    --out-dir)        OUT_DIR="$2"; shift 2 ;;
    --specs)          SPECS_OVERRIDE="$2"; shift 2 ;;
    --dry-run)        DRY_RUN=1; shift ;;
    --lista|--list|list) musica_list; exit 0 ;;
    -h|--help|--uso)  uso ;;
    *)                EXTRA+=("$1"); shift ;;
  esac
done

[ ! -x "$BIN" ] && {
  echo "erro: binário ausente: $BIN" >&2
  echo "compile: cd ~/git/audio.cpp && ./scripts/build_linux.sh --backend cuda --cuda-arch native --model-set custom --models ace_step --target audiocpp_cli -j 8" >&2
  echo "ver README: ~/git/ai-dotfiles/musica/README.md (seção Recuperação)" >&2
  exit 1
}

# ---------- resolver família ----------
FAMILIA=""; MDIR_REL=""; VSTEPS=""; USA_LETRA="sim"
resolver_familia "$MODELO"

# ACE-Step 'base' exige troca de variante do DiT
LOAD_OPT=()
[ "$MODELO" = "base" ] && LOAD_OPT+=(--load-option ace_step.dit_model_path=acestep-v15-base)

# ---------- ler entradas ----------
[ -n "$LETRA_FILE" ] && LETRA="$(cat "$LETRA_FILE")"
[ -n "$LEGENDA_FILE" ] && LEGENDA="$(cat "$LEGENDA_FILE")"

if [ "$INSTRUMENTAL" = "1" ] && [ "$FAMILIA" != "stable_audio" ]; then
  LETRA="[Instrumental]"
fi

# Stable Audio não tem letra — não exigir; demais famílias exigem
if [ "$USA_LETRA" = "sim" ] && [ -z "$LETRA" ]; then
  echo "erro: sem letra. use --letra ou --letra-file (ou --instrumental)" >&2
  exit 1
fi
if [ -z "$LEGENDA" ]; then
  echo "erro: sem legenda. use --legenda ou --legenda-file" >&2
  exit 1
fi

# ---------- nome de saída ----------
[ -z "$OUT" ] && OUT="$OUT_DIR/${FAMILIA}_${MODELO}_s${SEED}_${DUR}s.wav"
MDIR_ABS="$AUDIOCPP_HOME/$MDIR_REL"

# ---------- montar comando ----------
CMD=("$BIN" --task gen --family "$FAMILIA" --model "$MDIR_ABS" --backend cuda)
[ -n "$SPECS_OVERRIDE" ] && CMD+=(--model-spec-override "$SPECS_OVERRIDE")

case "$FAMILIA" in
  ace_step)
    CMD+=(--task-route text2music)
    CMD+=(--text "$LEGENDA")
    CMD+=(--lyrics "$LETRA")
    CMD+=(--language "$IDIOMA")
    CMD+=(--duration-seconds "$DUR")
    CMD+=(--num-inference-steps "$VSTEPS")
    [ -n "$GUIDANCE" ] && CMD+=(--guidance-scale "$GUIDANCE")
    CMD+=(--seed "$SEED")
    [ -n "$BPM" ] && CMD+=(--request-option "bpm=$BPM")
    [ -n "$TOM" ] && CMD+=(--request-option "keyscale=$TOM")
    [ -n "$COMPASSO" ] && CMD+=(--request-option "timesignature=$COMPASSO")
    CMD+=(--session-option ace_step.mem_saver=true)
    CMD+=("${LOAD_OPT[@]}")
    ;;
  stable_audio)
    CMD+=(--text "$LEGENDA")
    CMD+=(--duration-seconds "$DUR")
    CMD+=(--seed "$SEED")
    ;;
  heartmula)
    CMD+=(--text "$LEGENDA")
    CMD+=(--lyrics "$LETRA")
    CMD+=(--duration-seconds "$DUR")
    CMD+=(--seed "$SEED")
    ;;
esac

CMD+=(--out "$OUT" --metrics)
[ ${#EXTRA[@]} -gt 0 ] && CMD+=("${EXTRA[@]}")

# ---------- executar ----------
echo "=== musica — familia=$FAMILIA modelo=$MODELO ==="
echo "  saida : $OUT"
echo "  dur   : ${DUR}s | seed: $SEED | steps: $VSTEPS"
[ -n "$BPM" ] && echo "  bpm   : $BPM"
[ -n "$TOM" ] && echo "  tom   : $TOM"
[ -n "$COMPASSO" ] && echo "  compasso: $COMPASSO"
echo "  idioma: $IDIOMA | instrumental: $INSTRUMENTAL"
echo

if [ "$DRY_RUN" = "1" ]; then
  echo "--- comando (dry-run, nada executado) ---"
  printf '%q ' "${CMD[@]}"; echo
  exit 0
fi

# Unified memory e' o que faz os modelos maiores caberem em 6GB.
# NAO remover sem testar: sem UMA, ACE-Step nao passa da alocacao do DiT.
export GGML_CUDA_ENABLE_UNIFIED_MEMORY=1

mkdir -p "$(dirname "$OUT")"
START=$(date +%s)
"${CMD[@]}"
RC=$?
EL=$(( $(date +%s) - START ))

echo
echo "=== fim: $RC — $((EL/60))min $((EL%60))s ==="
# O marcador NAO e prova de sucesso: verificar o arquivo.
if [ -f "$OUT" ]; then
  ls -la "$OUT"
  ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1 "$OUT"
else
  echo "!!! WAV AUSENTE — a run FALHOU, nao celebrar !!!"
fi
exit $RC