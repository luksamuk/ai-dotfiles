#!/usr/bin/env bash
# ming — Ming Image 0.1 Design wrapper (Wan2GP headless), 5 modos:
#   flyer | ui | infografico | edit | cutout
# Fluxo: brief -> LLM enhance (llama-swap, system por modo) -> wgp.py --process (scope 20G) -> [composite foto real]
# Uso:
#   ming "BRIEF" [--mode flyer] [--ref IMG] [--paste IMG] [--slot "0.5,0.32,0.8,0.42"]
#        [--size WxH] [--seed N] [--steps N] [--cfg N] [--out DIR] [--enhance-with M]
#        [--no-enhance] [--dry]
# Exemplos:
#   ming "saturn, R$ 1.199,99 no pix, antes R$ 1.499,99, garantia 3 meses, parcela 10x"
#   ming "landing page da loja com hero e 3 cards de consoles" --mode ui
#   ming "poster 5 passos pra dar play no ps1" --mode infografico
#   ming "muda o preço pra 999 no pix" --mode edit --ref flyer.jpg
#   ming "hedgehog mascot sticker" --mode cutout
#   ming "..." --paste produto.jpg            # cola foto real no slot do flyer (auto-detect)

set -e
MODE="flyer"; REF=""; PASTE=""; SLOT=""; SIZE=""; SEED=""; STEPS=12; CFG="1.0"
OUT_DIR="$PWD"; ENH_MODEL="qwen3.5-4b"; NO_ENHANCE=0; DRY=0
BRIEF=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode) MODE="$2"; shift 2 ;;
    --ref) REF="$(readlink -m "$2")"; shift 2 ;;
    --paste) PASTE="$(readlink -m "$2")"; shift 2 ;;
    --slot) SLOT="$2"; shift 2 ;;
    --size|-s) SIZE="$2"; shift 2 ;;
    --seed) SEED="$2"; shift 2 ;;
    --steps) STEPS="$2"; shift 2 ;;
    --cfg) CFG="$2"; shift 2 ;;
    --out|-o) OUT_DIR="$(readlink -m "$2")"; shift 2 ;;
    --enhance-with) ENH_MODEL="$2"; shift 2 ;;
    --no-enhance) NO_ENHANCE=1; shift ;;
    --dry) DRY=1; shift ;;
    -h|--help) grep '^#' "$0" | head -30; exit 0 ;;
    *) if [[ -z "$BRIEF" ]]; then BRIEF="$1"; shift; else echo "arg desconhecido: $1" >&2; exit 2; fi ;;
  esac
done
[[ -n "$BRIEF" ]] || { echo "uso: ming \"BRIEF\" [flags] (--help)" >&2; exit 2; }
case "$MODE" in
  flyer|ui|infografico|edit|cutout) ;;
  *) echo "modo inválido: $MODE (flyer|ui|infografico|edit|cutout)" >&2; exit 2 ;;
esac
if [[ "$MODE" == "edit" && -z "$REF" ]]; then echo "modo edit exige --ref IMG (imagem base)" >&2; exit 2; fi
[[ "$DRY" == 1 ]] && [[ -n "$REF" ]] && echo "[warn] --dry não valida download da ref; só schema" >&2

PROMPT_DIR="$(dirname "$(readlink -f "$0")")"   # resolve symlink: ai-dotfiles/ming/ming
if [[ -d "$PROMPT_DIR/prompts" ]]; then
  PROMPT_DIR="$PROMPT_DIR/prompts"
fi
SYSTEM_MD="$PROMPT_DIR/${MODE}.md"
[[ -f "$SYSTEM_MD" ]] || { echo "system prompt não encontrado: $SYSTEM_MD" >&2; exit 2; }

WGP_DIR="${WGP_DIR:-$HOME/git/Wan2GP}"
VENV="$WGP_DIR/.venv/bin/activate"
[[ -f "$VENV" ]] || { echo "venv Wan2GP não encontrado em $WGP_DIR" >&2; exit 2; }
mkdir -p "$OUT_DIR"
TMP=$(mktemp -d /tmp/ming_XXXXXX)
trap 'rm -rf "$TMP"' EXIT
START_TS=$(date +%s)
[[ -z "$SEED" ]] && SEED=$(( RANDOM * 9999 + RANDOM ))
[[ -z "$SIZE" ]] && case "$MODE" in
  flyer|infografico) SIZE="832x1104" ;;
  ui) SIZE="1280x720" ;;
  edit|cutout) SIZE="1024x1024" ;;
esac

# ---------- ENHANCE (LLM no llama-swap) ----------
if [[ "$NO_ENHANCE" == 0 ]]; then
  echo "[ming 1/3] enhance via $ENH_MODEL (modo $MODE)..."
  SYSTEM_CONTENT=$(cat "$SYSTEM_MD")
  python3 - "$SYSTEM_CONTENT" "$BRIEF" "$TMP/body.json" <<'PY'
import json, sys
system, brief, out = sys.argv[1], sys.argv[2], sys.argv[3]
payload = {
    "model": None,  # filled by wrapper env
    "messages": [{"role": "system", "content": system}, {"role": "user", "content": brief}],
    "temperature": 0.4, "max_tokens": 4096,
}
json.dump(payload, open(out, "w"))
PY
  # injeta model no payload (evita quoting torto)
  python3 -c "import json,sys; d=json.load(open('$TMP/body.json')); d['model']='$ENH_MODEL'; json.dump(d, open('$TMP/body.json','w'))"
  SWAP_URL="${LLAMA_SWAP_URL:-http://127.0.0.1:12434}"
  ENH_OK=0
  for i in 1 2; do
    RESP=$(curl -s --max-time 240 "$SWAP_URL/v1/chat/completions" -H 'Content-Type: application/json' -d @"$TMP/body.json" || true)
    echo "$RESP" > "$TMP/resp.json"
    CONTENT=$(python3 -c "
import json,sys,re
try:
    d=json.load(open('$TMP/resp.json'))
    c=d['choices'][0]['message']['content'].strip()
    c=re.sub(r'^\`\`\`(?:json)?\s*','',c); c=re.sub(r'\`\`\`\s*$','',c)
    print(c)
except Exception: pass" 2>/dev/null || true)
    if [[ -n "$CONTENT" ]]; then
      echo "$CONTENT" > "$TMP/last_prompt.txt"   # payload por ARQUIVO (nunca argv/env — gotcha doutrinado)
      if [[ "$MODE" == "cutout" ]] || python3 -c "
import json,sys
raw = open('$TMP/last_prompt.txt').read().strip()
json.loads(raw)
" 2>/dev/null; then
        ENH_OK=1; break
      fi
      echo "  [tentativa $i] resposta não é JSON válido — reforçando e tentando de novo..."
      python3 -c "import json; d=json.load(open('$TMP/body.json')); d['messages'][-1]['content'] += '\n\n(Atenção: sua resposta anterior não parseou como JSON. Retorne APENAS o objeto JSON válido, sem fences)'; json.dump(d, open('$TMP/body.json','w'), ensure_ascii=False)"
    else
      echo "  [tentativa $i] LLM não respondeu (llama-swap em $SWAP_URL)..."
    fi
  done
  if [[ "$ENH_OK" == 0 ]]; then echo "[ming] enhance FALHOU — abortando (use --no-enhance pra mandar prompt cru)" >&2; exit 3; fi
  FINAL_PROMPT="$CONTENT"
  echo "[ming] evict do LLM antes do render..."
  ~/.local/bin/llama-swap-cli unload >/dev/null 2>&1 || true
  sleep 2
else
  FINAL_PROMPT="$BRIEF"
fi

# ---------- SETTINGS JSON ----------
python3 - "$FINAL_PROMPT" "$MODE" "$SIZE" "$SEED" "$STEPS" "$CFG" "$REF" "$TMP/settings.json" <<'PY'
import json, sys
prompt, mode, size, seed, steps, cfg, ref, out = sys.argv[1:9]
d = {"model_type": "ming_image_0_1_design", "prompt": prompt, "resolution": size,
     "num_inference_steps": int(steps), "guidance_scale": float(cfg), "seed": int(seed), "batch_size": 1}
if mode == "cutout":
    d["custom_settings"] = {"rgba": "Enabled"}
if mode == "edit":
    d["image_prompt_type"] = "I"
    d["image_refs"] = [ref]
json.dump(d, open(out, "w"), ensure_ascii=False, indent=2)
PY

# ---------- RENDER ----------
echo "[ming 2/3] render via Wan2GP (profile 5, scope 20G)..."
systemd-run --user --scope -p MemoryMax=20G bash -c "source '$VENV' && cd '$WGP_DIR' && python wgp.py --process '$TMP/settings.json' --profile 5 --output-dir '$OUT_DIR' $([[ "$DRY" == 1 ]] && echo --dry) --verbose 2" > "$TMP/wgp.log" 2>&1
WGP_EXIT=$?
if [[ $WGP_EXIT -ne 0 ]]; then tail -20 "$TMP/wgp.log" >&2; echo "[ming] render falhou (exit $WGP_EXIT)" >&2; exit 4; fi
NEWEST=$(find "$OUT_DIR" -maxdepth 1 \( -name '*.jpg' -o -name '*.png' \) -newermt "@$START_TS" -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
[[ -n "$NEWEST" ]] || { echo "[ming] nenhuma imagem nasceu no diretório (log: $TMP/wgp.log)" >&2; exit 5; }
echo "[ming] render: $NEWEST"

# ---------- COMPOSITE (foto real no slot) ----------
if [[ -n "$PASTE" ]]; then
  echo "[ming 3/3] composite da foto real..."
  "$WGP_DIR/.venv/bin/python" - "$NEWEST" "$PASTE" "$SLOT" <<'PY'
import sys
from PIL import Image, ImageFilter
flyer_path, paste_path, slot_s = sys.argv[1], sys.argv[2], sys.argv[3]
flyer = Image.open(flyer_path).convert("RGB"); W, H = flyer.size
try:
    import numpy as np
    a = np.asarray(flyer).astype(int)
    top = a[: int(H * 0.60)]
    light = (top.mean(axis=2) > 225) & (top.std(axis=2) < 14)
    from scipy import ndimage
    lbl, n = ndimage.label(light)
    if n:
        sizes = ndimage.sum(light, lbl, range(1, n + 1))
        big = (sizes.argmax() + 1)
        ys, xs = np.where(lbl == big)
        x0, x1, y0, y1 = xs.min(), xs.max(), ys.min(), ys.max()
        if (x1 - x0) > W * 0.3 and (y1 - y0) > H * 0.15:
            SX, SY, SW, SH = x0 + 10, y0 + 10, x1 - x0 - 20, y1 - y0 - 20
        else:
            raise ValueError
    else:
        raise ValueError
except Exception:
    cx, cy, cw, ch = (0.5, 0.32, 0.8, 0.42)
    SX, SY, SW, SH = int(W * (cx - cw / 2)), int(H * (cy - ch / 2)), int(W * cw), int(H * ch)
photo = Image.open(paste_path).convert("RGB")
ratio = min(SW / photo.width, SH / photo.height)
nw, nh = int(photo.width * ratio), int(photo.height * ratio)
photo = photo.resize((nw, nh), Image.LANCZOS)
bg = Image.new("RGB", (SW, SH), tuple(int(x) for x in np.asarray(flyer)[SY + 5, SX + SW // 2]))
bg.paste(photo, ((SW - nw) // 2, (SH - nh) // 2))
mask = Image.new("L", (SW, SH), 0)
from PIL import ImageDraw
d = ImageDraw.Draw(mask)
d.rectangle([8, 8, SW - 8, SH - 8], fill=255)
mask = mask.filter(ImageFilter.GaussianBlur(6))
flyer.paste(bg, (SX, SY), mask)
out = flyer_path.replace(".jpg", "_vreal.jpg")
flyer.save(out, quality=92)
print(out)
PY
  COMPOSITE_OUT=$(find "$OUT_DIR" -maxdepth 1 -name '*_vreal.jpg' -newermt "@$START_TS" | head -1)
  if [[ -n "$COMPOSITE_OUT" ]]; then NEWEST="$COMPOSITE_OUT"; echo "[ming] final: $NEWEST"; fi
fi

cp "$TMP/wgp.log" "$OUT_DIR/.ming_last.log" 2>/dev/null || true
echo "OK $NEWEST (seed $SEED)"