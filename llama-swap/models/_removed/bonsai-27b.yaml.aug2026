bonsai-27b:
  name: Bonsai 27B 1-bit
  description: PrismML's 1-bit 27B reasoning model — Qwen3.6-27B with true 1.125-bit
    binary weights, full thinking/reasoning at ~3.9 GB. 89.5% of FP16 intelligence.
    Full GPU offload on RTX 3050 6GB. Upstream llama.cpp with ngram-mod/dspark speculative
    decoding.
  cmd: '${llama_server} --port ${PORT}

    --model ${models_dir}/bonsai-27b/Bonsai-27B-Q1_0.gguf

    --mmproj ${models_dir}/bonsai-27b/Bonsai-27B-mmproj-Q8_0.gguf

    --no-mmproj-offload

    --jinja

    -ngl 99

    --ctx-size 131072

    --no-kv-offload

    --temp 0.7

    --top-p 0.95

    --top-k 20

    --min-p 0

    --repeat-penalty 1.0

    --parallel 1

    --cache-type-k ${large_cache_k}

    --cache-type-v ${large_cache_v}

    --flash-attn on

    --spec-type ngram-mod

    --spec-ngram-mod-n-max 64

    --spec-ngram-mod-n-min 48

    --spec-ngram-mod-n-match 24

    --metrics

    '
  filters:
    stripParams: temperature, top_p, top_k, min_p
    setParamsByID:
      ${MODEL_ID}:
        chat_template_kwargs:
          enable_thinking: false
        temperature: 0.7
        top_p: 0.95
        top_k: 20
        min_p: 0
      ${MODEL_ID}:think:
        chat_template_kwargs:
          enable_thinking: true
        temperature: 0.7
        top_p: 0.95
        top_k: 20
        min_p: 0
  ttl: 900
  health_check_timeout: 900
  capabilities:
    in:
    - text
    - image
    out:
    - text
    tools: true
    reranker: false
    context: 131072
  metadata:
    size: ~3.9 GB (Q1_0 binary 1.125 bpw) + 0.63 GB mmproj
    context: 131072
    vram_usage: ~4.4 GB VRAM
    source: prism-ml/Bonsai-27B-gguf (Q1_0 + dspark-Q4_1 sidecar + mmproj Q8_0)
    kv_cache: q4_0 (host RAM)
    features:
      completion: true
      tools: true
      thinking: true
      vision: true
      embedding: false
      insert: false
      audio: false
      image: false
    architecture: qwen35
    parameters: 27300000000
    context_length: 262144
    embedding_length: 5120
    quantization: Q1_0
    note: 'vram detalhe: ~4.4 GB VRAM (Q1_0 weights + compute; mmproj in RAM, KV in
      host RAM) 1-bit binary 1.125 bpw, Qwen3.6-27B base. Full GPU resident. Aug 30
      2026: canonical 128K ctx via --no-kv-offload (KV in host RAM), 10.95 tok/s;
      speed mode 48K KV-GPU, 22.91 tok/s; mmproj-RAM; dspark sidecar incompatible,
      deleted. Jul 2026 measurements: 32K=27 tok/s, 48K=20 tok/s with ngram-mod.'
