if os.environ.get('H3_LORAS_JSON') and os.environ['H3_LORAS_JSON'] != '[]':
    ex_loras = json.loads(os.environ['H3_LORAS_JSON'])
    ex_mults = json.loads(os.environ.get('H3_LORAS_MULTS_JSON', '[]'))
    for i, fname in enumerate(ex_loras):
        fname_full = fname if fname.endswith('.safetensors') else fname + '.safetensors'
        if fname_full not in activated_loras:
            activated_loras.append(fname_full)
            loras_multipliers.append(float(ex_mults[i]) if i < len(ex_mults) else 1.0)

if activated_loras:
    settings['activated_loras'] = activated_loras
    # Wan2GP aceita string espaço-separada de floats
    settings['loras_multipliers'] = ' '.join(str(m) for m in loras_multipliers)

with open('$SETTINGS_FILE', 'w') as f:
    json.dump(settings, f, indent=2)
"

