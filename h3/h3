fi
if [[ "$REF2VA_MODE" == true ]]; then
  [[ ${#REF_IMAGES[@]} -gt 0 ]] && echo "Ref images: ${REF_IMAGES[*]}"
  [[ -n "$REF_VIDEO" ]] && echo "Ref video 1: $REF_VIDEO"
  [[ -n "$REF_VIDEO2" ]] && echo "Ref video 2: $REF_VIDEO2"
  [[ -n "$REF_AUDIO" ]] && echo "Ref audio 1: $REF_AUDIO"
  [[ -n "$REF_AUDIO2" ]] && echo "Ref audio 2: $REF_AUDIO2"
  [[ "$USE_SOUNDTRACK" == true ]] && echo "Use soundtrack: yes"
  echo "Video prompt type: $VIDEO_PROMPT_TYPE"
  echo "Audio prompt type: $AUDIO_PROMPT_TYPE"
