if [[ "$FACIAL" == true ]]; then
  echo "Facial: $FACIAL_FILE (força $FACIAL_STRENGTH)"
fi
if [[ "$NAFASP" == true ]]; then
  echo "NAFASP: $NAFASP_FILE (força $NAFASP_STRENGTH)"
