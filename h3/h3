# ── Dry-run: mostrar tudo e encerrar ─────────────────────────────────────
if [[ "$DRY_RUN" == "1" ]]; then
  echo "=== DRY RUN — settings JSON ==="
  cat "$SETTINGS_FILE"
  echo ""
  echo "=== Encerrando sem gerar (--dry-run) ==="
  rm -f "$SETTINGS_FILE"
  exit 0
fi

source "$VENV/bin/activate"
cd "$WAN2GP_DIR"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
START_TIME=$(date +%s)
# Filtro de saída (h3-output-filter.py): compacta o chatter de offload (150 linhas
# de blocos/step) numa linha viva "step N/M · blocks K/50 · 69s/step"; barra tqdm
# e todo o resto passam limpos. Log íntegro em /tmp/h3_debug.log (append por run).
# Escape: H3_RAW_OUTPUT=1 h3 ... rodeia o filtro e mostra tudo cru.
DEBUG_LOG=/tmp/h3_debug.log
if [[ "$H3_RAW_OUTPUT" == "1" ]]; then
  python wgp.py --process "$SETTINGS_FILE" --profile 5 --output-dir "$OUTPUT_DIR" --verbose 2
  RC=$?
else
  rm -f "$DEBUG_LOG"
  set -o pipefail
  python wgp.py --process "$SETTINGS_FILE" --profile 5 --output-dir "$OUTPUT_DIR" --verbose 2 2>&1 |
    python3 "$HOME/.local/bin/h3-output-filter.py" "$DEBUG_LOG"
  RC=$?
  set +o pipefail
fi
END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))
echo ""
if [[ "${ELAPSED:-0}" =~ ^[0-9]+$ ]]; then
  echo "=== Tempo total: ${ELAPSED}s ($((ELAPSED / 60))m$((ELAPSED % 60))s) ==="
fi
echo "=== Log completo (sem filtro): $DEBUG_LOG ==="
rm -f "$SETTINGS_FILE"
exit $RC
