#!/bin/bash
# h3 — atalho para gerar vídeo+áudio via MiniMax H3 no Wan2GP
#
# Modos:
#   t2v   — text-to-video+audio (padrão)
#   i2v   — image-to-video+audio (FL2VA: primeira e/ou última frame)
#   ref   — reference-to-video+audio (Ref2VA: imagens, vídeos, áudios de referência)
#
# Uso:
#   h3 "prompt"                                      # t2v 4.5s
#   h3 "prompt" --frames 241                          # ~10s
#   h3 "prompt" --image-start foto.jpg                # FL2VA: primeira frame
#   h3 "prompt" --image-start a.jpg --image-end b.jpg # FL2VA: primeira + última
#   h3 "prompt" --image-end foto.jpg                  # FL2VA: última frame only
#   h3 "prompt" --ref-img char.jpg --ref-video vid.mp4 # Ref2VA: img + vídeo
#   h3 "prompt" --ref-img a.jpg --ref-img b.jpg --ref-audio audio.wav
#   h3 "prompt" --ref-video vid.mp4 --use-soundtrack  # Ref2VA: vídeo + soundtrack
#   h3 "prompt" --enhance                             # expande prompt via LLM
#   h3 "prompt" --dry-run                             # mostra configs e encerra
#   h3 --web                                          # interface web

WAN2GP_DIR="$HOME/git/Wan2GP"
VENV="$WAN2GP_DIR/.venv"
OUTPUT_DIR="$PWD"
LLAMA_SWAP_URL="http://localhost:12434/v1/chat/completions"
OLLAMA_URL="http://localhost:11434/v1/chat/completions"

# H3 defaults (do handler: 20 steps, guidance 1.0, flow_shift 12, euler, 24fps)
PROMPT=""
FRAMES=107        # ~4.5s a 24fps (mínimo do H3)
STEPS=50
SEED=""             # vazio = seed aleatório por geração (0-999999999, range do Wan2GP)
GUIDANCE=1.0
FLOW_SHIFT=12.0
DRY_RUN=""
WEB=false
ENHANCE=false
ENHANCE_MODEL=""
ENHANCE_DEFAULT="qwen3.6-35b-a3b-heretic"
ENHANCE_WITH_VISION=false  # --enhance-with-vision: imagens vao inline no pedido de enhance
RESOLUTION="832x480"
SHOW_ENHANCED=false
VISION_DESCRIBE=true
VLM_MODEL="lfm2.5-vl-3b"
VLM_MODEL_OVERRIDE=""
MAX_IMAGE_MP="1.0"  # Max megapixels per image (ref2va ref images + fl2va start/end frames)
# Redimensiona imagens que excedem este limite para /tmp antes de processar,
# mantendo aspect ratio e alinhamento ao fator 32 do Qwen3-VL.

# NSFW LoRA — suporta múltiplas LoRAs empilhadas com forças individuais
NSFW=false
NSFW_LORAS=()                       # lista de LoRAs NSFW (repeatable)
# Defaults: genitália feminina + penetração + movimento rítmico
# 29/09: pilha antiga removida; defaults AGORA = fallback do catálogo novo (~/v/nsfw_catalog_h3.json).
# A resolução NSFW completa (IDs→stems→mults→triggers) passa pelo nsfw_lora_resolve.py.
NSFW_DEFAULT_LORAS=()
declare -A NSFW_LORA_STRENGTHS=()   # strengths agora vêm do catálogo (strength_autor)
NSFW_AVAILABLE_LORAS=""   # populado do catálogo
NSFW_CATALOG_JSON="${NSFW_CATALOG_JSON:-$HOME/.local/share/h3/nsfw_catalog_h3.json}"
NSFW_RESOLVER="${NSFW_RESOLVER:-$HOME/.local/share/h3/nsfw_lora_resolve.py}"
FORCE_NSFW_LORA_IDS=""   # --force-nsfw-loras "1,2,3"

# Turbo LoRA (destilação — reduz 80 steps pra 4-8)
# Usar versão ComfyUI-pruned (compatível com Wan2GP). A versão diffusers original
# tem keys diferentes (transformer_blocks/token_refiner) que o Wan2GP não reconhece.
TURBO=false
TURBO_STEPS=4                       # 4 (o rank-21 resized é treinado pra 4)
TURBO_STRENGTH="1.0"                # lightx2v recomenda 1.0
# Único turbo compatível com o pruned Q4 (full-rank = MOSAICO — doutrina 30/09):
TURBO_FILE="minimax_h3_fl2v_lightx2v_turbo_4step_v0.1_comfy_resized_avg_rank_21_bf16.safetensors"

# Facial Realism LoRA (close-up de rosto — textura de pele, micro-expressões)
# prithivMLmods/MiniMax-H3-Facial-Realism-CloseUp, cp2000, rank 16, trigger "Facial Realism"
FACIAL=false
FACIAL_STRENGTH="1.0"
FACIAL_FILE_OVERRIDE=""

# NAFASP — Natural Face & Speech LoRA (vpakarinen): DEFAULT ON @0.6 (2026-09-08).
# Fala natural + dinâmica facial. A/B mesmo seed/prompt: turbo+nafasp venceu pra
# cartoon. Card: peso 0.4-0.8. Não empilhar com --facial (mesmos módulos-alvo) —
# se --facial for passado, o nafasp se auto-desativa. Desligar: --no-nafasp.
NAFASP=true
NAFASP_STRENGTH="0.6"
NAFASP_FILE_OVERRIDE=""
NAFASP_FILE=""

# LoRAs genéricas (--lora NOME[@FORÇA], repeatable) + catálogo (--list-loras)
LIST_LORAS=false
LORA_RAW=()        # specs crus do usuário
LORA_NAMES=()      # arquivos resolvidos (sem extensão)
LORA_MULTS=()

# PDD 8-step (Parallel Decoding Distillation — Wan2GP v12.645, DeepBeepMeep)
# Substitui o turbo LoRA: heads no ckpts/ + LoRA auxiliar carregado pelo model def.
PDD=false
W4A8=false

# Duas fases com tiling (fase 1 low-res → latent upscaler → fase 2 em 4 tiles).
# Vence o OOM de denoise full-res em 720p+ no 6GB. Exige modelo normal (não-PDD/turbo).
TWO_PHASE=false


# FL2VA inputs
IMAGE_START=""
IMAGE_END=""

# Ref2VA inputs
REF_IMAGES=()
REF_VIDEO=""
REF_VIDEO2=""
REF_AUDIO=""
REF_AUDIO2=""
USE_SOUNDTRACK=false

# ── Resolução de LoRAs: apelidos didáticos → arquivos ─────────────────────
resolve_lora() {
  local input="$1" key hits
  key="$(echo "$input" | tr '[:upper:]' '[:lower:]')"
  # 1) arquivo exato (com ou sem extensão)
  if [[ -f "$WAN2GP_DIR/loras/minimax_h3/${input}.safetensors" ]]; then
    echo "$input"; return 0
  fi
  if [[ -f "$WAN2GP_DIR/loras/minimax_h3/${input}" ]]; then
    echo "${input%.safetensors}"; return 0
  fi
  # 2) apelidos
  case "$key" in
    nafasp|nafasp_v1|natural-face-speech|natural_face_speech) echo "natural_face_speech_h3_lora_v1_500"; return 0 ;;
    facial|facial-realism|facial_realism|cp2000) echo "minimax-h3-facial-realism-closeup-cp2000"; return 0 ;;
    grindtime) echo "Grindtime"; return 0 ;;
    aio|hmnsfw) echo "HMNSFW_AIO_V2"; return 0 ;;
    hmpussy) echo "hmpussy_v6"; return 0 ;;
    penetration|hmotion) echo "HMPenetration_I2V"; return 0 ;;
    turbo-fl2v|turbo8) echo "minimax_h3_fl2v_lightx2v_turbo_8step_v1.0_resized_avg_rank_24_bf16"; return 0 ;;
    turbo-ref|turbo4) echo "minimax_h3_ref2v_turbo_4step_v0.1_comfyui_resized_avg_rank_21_bf16"; return 0 ;;
    pdd-fl2v) echo "minimax_h3_fl2va_pdd_8step_lora_bf16"; return 0 ;;
    pdd-ref) echo "minimax_h3_ref2va_pdd_8step_lora_bf16"; return 0 ;;
  esac
  # 3) busca parcial case-insensitive (1 hit = resolve)
  hits=$(ls -1 "$WAN2GP_DIR/loras/minimax_h3/" 2>/dev/null | grep -i "$key" | grep '\.safetensors$' || true)
  if [[ "$(echo "$hits" | grep -c .)" == "1" ]]; then
    echo "${hits%.safetensors}"; return 0
  fi
  return 1
}

lora_desc() {
  case "$1" in
    natural_face_speech_h3_lora_v1_500) echo "NAFASP: fala natural + dinâmica facial [DEFAULT ON @0.6, --no-nafasp desliga]" ;;
    minimax-h3-facial-realism-closeup-cp2000) echo "Facial Realism cp2000: poros/textura de pele em close-up humano [use --facial]" ;;
    Grindtime) echo "NSFW: movimento rítmico de quadril [rec 0.5]" ;;
    HMNSFW_AIO_V2) echo "NSFW: AIO posições variadas [rec 0.5]" ;;
    hmpussy_v6) echo "NSFW: genitália feminina [rec 0.5]" ;;
    HMPenetration_I2V) echo "NSFW I2V: penetração, trigger 'hmotion' [rec 0.5]" ;;
    minimax_h3_fl2v_lightx2v_turbo_8step_v1.0_resized_avg_rank_24_bf16) echo "TURBO FL2VA 8-step [prefira --turbo]" ;;
    minimax_h3_ref2v_turbo_4step_v0.1_comfyui_resized_avg_rank_21_bf16) echo "TURBO Ref2VA 4-step [prefira --turbo]" ;;
    minimax_h3_fl2va_pdd_8step_lora_bf16) echo "PDD FL2VA 8-step [prefira --pdd]" ;;
    minimax_h3_ref2va_pdd_8step_lora_bf16) echo "PDD Ref2VA 8-step [prefira --pdd]" ;;
    *) echo "" ;;
  esac
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --frames) FRAMES="$2"; shift 2 ;;
    --steps)  STEPS="$2"; shift 2 ;;
    --seed)   SEED="$2"; shift 2 ;;
    --guidance) GUIDANCE="$2"; shift 2 ;;
    --flow-shift) FLOW_SHIFT="$2"; shift 2 ;;
    --dry-run) DRY_RUN="1"; shift ;;
    --web)     WEB=true; shift ;;
    --enhance) ENHANCE=true; shift ;;
    --enhance-with) ENHANCE=true; ENHANCE_MODEL="$2"; shift 2 ;;
    --enhance-with-vision) ENHANCE=true; ENHANCE_WITH_VISION=true; shift ;;
    --vision-with) VLM_MODEL_OVERRIDE="$2"; shift 2 ;;
    --resolution) RESOLUTION="$2"; shift 2 ;;
    --show-enhanced) SHOW_ENHANCED=true; shift ;;
    --no-vision-describe) VISION_DESCRIBE=false; shift ;;
    --max-image-mp) MAX_IMAGE_MP="$2"; shift 2 ;;
    # FL2VA
    --image-start) IMAGE_START="$2"; shift 2 ;;
    --image-end)   IMAGE_END="$2"; shift 2 ;;
    # Ref2VA
    --ref-img)    REF_IMAGES+=("$2"); shift 2 ;;
    --ref-video)  REF_VIDEO="$2"; shift 2 ;;
    --ref-video2) REF_VIDEO2="$2"; shift 2 ;;
    --ref-audio)  REF_AUDIO="$2"; shift 2 ;;
    --ref-audio2) REF_AUDIO2="$2"; shift 2 ;;
    --use-soundtrack) USE_SOUNDTRACK=true; shift ;;
    --nsfw) NSFW=true; shift ;;
    --force-nsfw-loras) FORCE_NSFW_LORA_IDS="$2"; shift 2 ;;
    --nsfw-lora) NSFW=true; NSFW_LORAS+=("$2"); shift 2 ;;
    --nsfw-strength) NSFW=true; NSFW_OVERRIDE_STRENGTH="$2"; shift 2 ;;  # sobrescreve todas
    --turbo) TURBO=true; shift ;;
    --turbo-strength) TURBO=true; TURBO_STRENGTH="$2"; shift 2 ;;
    --turbo-file) TURBO=true; TURBO_FILE_OVERRIDE="$2"; shift 2 ;;
    --output|-o|--output-dir)
      case "$2" in
        /*) OUTPUT_DIR="$(readlink -m "$2")" ;;
        *)  OUTPUT_DIR="$(readlink -m "$PWD/$2")" ;;
      esac
      shift 2 ;;
    --facial) FACIAL=true; shift ;;
    --facial-strength) FACIAL=true; FACIAL_STRENGTH="$2"; shift 2 ;;
    --facial-file) FACIAL=true; FACIAL_FILE_OVERRIDE="$2"; shift 2 ;;
    --no-nafasp) NAFASP=false; shift ;;
    --nafasp) NAFASP=true; shift ;;
    --nafasp-strength) NAFASP=true; NAFASP_STRENGTH="$2"; shift 2 ;;
    --nafasp-file) NAFASP=true; NAFASP_FILE_OVERRIDE="$2"; shift 2 ;;
    --lora) LORA_RAW+=("$2"); shift 2 ;;
    --list-loras) LIST_LORAS=true; shift ;;
    --pdd) PDD=true; shift ;;
    --2p|--two-phase) TWO_PHASE=true; shift ;;
    --w4a8) W4A8=true; shift ;;
    --*)
      echo "Erro: flag desconhecida: $1"
      echo "(flags de valor: --flag VAL; booleanas: --flag; -h pra ajuda)"
      exit 1 ;;
    -h|--help)
      cat << 'HELPEOF'
h3 — gerar vídeo+áudio via MiniMax H3

Uso: h3 "prompt" [opções]

Modos:
  (padrão)                     Text-to-Video+Audio (t2v)
  --image-start PATH           FL2VA: primeira frame do vídeo
  --image-end PATH             FL2VA: última frame do vídeo
  --image-start A --image-end B  FL2VA: primeira + última frame
  --ref-img PATH (repeatable)  Ref2VA: imagem de referência (até 9)
  --ref-video PATH              Ref2VA: vídeo de referência 1
  --ref-video2 PATH             Ref2VA: vídeo de referência 2
  --ref-audio PATH              Ref2VA: áudio de referência 1
  --ref-audio2 PATH             Ref2VA: áudio de referência 2
  --use-soundtrack              Ref2VA: usar soundtrack do vídeo de referência

Opções gerais:
  --frames N         Número de frames (default: 107, ~4.5s). 107=min, 481=~20s
  --steps N          Steps de denoising (default: 50)
  --seed N           Seed (default: aleatório, 0-999999999; passe N pra fixar)
  --guidance N       Guidance scale (default: 1.0)
  --flow-shift N     Flow shift (default: 12.0)
  --resolution WxH   Resolução (default: 832x480). Ex: 480x256, 416x224
  --2p               Duas fases com tiling: denoise em resolução reduzida + upscaler
                     latente + refinamento em 4 tiles. Vence o OOM de 720p+ no 6GB.
                     Custo ~3x tempo. Combina com --turbo (fase 1 acelerada, ~3x mais
                     rápido que --2p sozinho). Incompatível com --pdd.
  --enhance          Expande prompt via LLM (llama-swap)
  --enhance-with M   LLM específico para enhance (default: qwen3.5-4b)
                     Use prefixo ollama: para modelos via Ollama (porta 11434):
                     --enhance-with ollama:glm-5.2:cloud
  --enhance-with-vision  Coringa: imagens de --image-start/--image-end/--ref-img
                     vão INLINE no pedido de enhance (modelo precisa ter vision).
                     Um passo só: o próprio LLM de enhance vê as refs e gera o
                     prompt descritivo — pula o vision describe separado.
  --vision-with M    VLM específico p/ descrever refs (default: qwen3-vl-4b).
                     Aceita ollama: igual ao --enhance-with (ex: ollama:gemma4:12b)
  --show-enhanced    Mostra prompt expandido antes de gerar
  --no-vision-describe  Pula a descrição visual via VLM (qwen3-vl-4b)
  --max-image-mp N    Max megapixels por imagem (default: 1.0). Imagens maiores
                     são redimensionadas para /tmp mantendo aspect ratio.
  --dry-run          Mostra as configurações e encerra sem gerar
  --nsfw              Carrega LoRAs NSFW (default: hmpussy_v6@0.5 + HMPenetration_I2V@0.5 + Grindtime@0.5)
                     Usa os três por padrão: genitália feminina + penetração + movimento rítmico
  --nsfw-lora NAME    Especifica um LoRA NSFW (repeatable, empilha múltiplos):
                     HMNSFW_AIO_V2   (AIO: posições variadas, 0.5)
                     hmpussy_v6     (genitália feminina, 0.5)
                     minimax_vag    (genitália feminina leve, 0.6)
                     vagassist_e40  (assistência vaginal, 0.5)
                     HMInnie_v1_e50 (innie vagina, 0.5)
                     HMPenetration_I2V (penetração I2V: missionary/cowgirl/doggy, 0.5)
                     Grindtime      (movimento rítmico de quadril durante sexo, 0.5)
                     PenisV2M3_000002750 (genitália masculina, 0.5)
                     PornMaster_penis_side_view_I2V_V1 (genitália masculina I2V, 0.5)
  --nsfw-strength N   Sobrescreve força de TODOS os LoRAs NSFW (default: força
                     recomendada de cada um; sem catálogo = 0.8, range 0.1-1.0)
  --turbo             Ativa LoRA Turbo (destilação: ~10x mais rápido)
                     Default: rank-21 resized @4 steps (único compatível com o
                     pruned Q4 — full-rank 768p = MOSAICO; ver doutrina 30/09)
  --turbo-strength N  Força do LoRA Turbo (default: 1.0, lightx2v recomenda 1.0)
  --turbo-file NOME   Override do LoRA Turbo (default: fl2v rank-21 resized)
  --facial            Ativa LoRA Facial Realism (close-up de rosto: poros, textura
                     de pele, micro-expressões). Empilha com --turbo. Trigger word
                     "Facial Realism" é injetada no prompt automaticamente
  --facial-strength N Força do LoRA Facial (default: 1.0, range 0.1-1.0)
  --facial-file NOME  Override do arquivo do LoRA Facial
  --no-nafasp         Desativa o LoRA NAFASP (natural face & speech, DEFAULT ON @0.6)
  --nafasp-strength N Força do NAFASP (default: 0.6, card recomenda 0.4-0.8)
  --nafasp-file NOME  Override do arquivo do LoRA NAFASP
  --lora NOME[@FORÇA] Carrega qualquer LoRA (repeatable; aceita apelidos didáticos,
                     ex: --lora nafasp@0.6 --lora grindtime@0.5)
  --list-loras        Lista LoRAs disponíveis com descrições e sai
  --web              Abre interface web (Gradio UI)
  -h, --help         Esta ajuda

Regras Ref2VA:
  - Vídeos de referência: 2-15s cada, total máximo 15s
  - Áudios de referência: 2-15s cada, total máximo 15s
  - Máximo 12 arquivos de referência no total
  - Áudio requer >= referências visuais (imgs+vídeos) que áudios
  - --use-soundtrack usa o audio track dos vídeos de referência

Enhance:
  Usa llama-swap (localhost:12434) para expandir o prompt.
  O LLM não recebe as imagens/vídeos/áudios em si. Recebe apenas o prompt
  do usuário + um contexto estruturado dizendo quantos de cada tipo foram
  passados e em qual modo (first-frame vs referência). Assim o LLM escreve
  o prompt H3 com os labels corretos (<Picture N>, <Video N>, <Audio N>)
  sem mudar a semântica do que o usuário pediu.
  Com --enhance e imagens de entrada, o Qwen3-VL-4B descreve cada imagem
  antes do enhance, enriquecendo o contexto visual do LLM. Use
  --no-vision-describe para pular essa etapa.

Modelos (symlinked em ckpts/):
  Transformer:  MiniMax-H3-FL2VA-pruned_int8_convrot.safetensors (21 GB)
  Text Encoder: qwen3vl-32B-MiniMax-H3-Q4_K_M.gguf (5 GB)
  VAEs:         MiniMax-H3-video_vae_fp16 + audio_vae_fp32 (5.5 GB)

Exemplos:
  h3 "A jazz duo performing in a softly lit club"
  h3 "A jazz duo in a club" --enhance --steps 30
  h3 "Will Smith eating spaghetti" --image-start will.jpg --enhance
  h3 "A character walks through a forest" --image-start forest.jpg --image-end exit.jpg
  h3 "A hero with a red cape" --ref-img hero.jpg --ref-video action.mp4
  h3 "Continue this scene" --ref-video scene.mp4 --use-soundtrack
  h3 "A singer performs" --ref-img singer.jpg --ref-audio song.wav --enhance --show-enhanced
  h3 "explicit prompt here" --nsfw                            # NSFW (LoRAs default a 0.5, ver flags acima)
  h3 "explicit prompt here" --turbo --steps 6            # Turbo com 6 steps (melhor qualidade)
  h3 "A close-up portrait of a woman smiling" --turbo --facial   # Realismo facial (trigger injetado)
  h3 "portrait close-up" --turbo --facial --facial-strength 0.7  # Facial mais sutil
HELPEOF
      exit 0 ;;
    *) PROMPT="$1"; shift ;;
  esac
done

# ── --list-loras: catálogo didático ───────────────────────────────────────
if [[ "$LIST_LORAS" == true ]]; then
  echo "=== LoRAs em loras/minimax_h3/ ==="
  echo ""
  while IFS= read -r f; do
    base=$(basename "$f" .safetensors)
    desc=$(lora_desc "$base")
    if [[ -n "$desc" ]]; then
      printf '  %-64s %s\n' "$base" "$desc"
    else
      printf '  %s\n' "$base"
    fi
  done < <(ls -1 "$WAN2GP_DIR/loras/minimax_h3/"*.safetensors 2>/dev/null)
  echo ""
  echo "Uso: --lora NOME[@FORÇA]  (repeatable; aceita apelidos: nafasp, facial, grindtime,"
  echo "     aio, hmpussy, penetration, turbo-fl2v...)"
  echo "Ex.: h3 \"...\" --lora nafasp@0.6 --lora grindtime@0.5"
  echo "Nota: nafasp já é padrão (@0.6). Turbo e PDD têm flags próprias (--turbo/--pdd)."
  exit 0
fi

if [[ "$WEB" == true ]]; then
  source "$VENV/bin/activate"
  cd "$WAN2GP_DIR"
  python wgp.py --profile 1 --t2v
  exit 0
fi

# Dry-run não deve disparar side effects (chamadas reais a VLM/enhance LLM);
# o vision describe faz chamadas reais, então desativamos no dry-run.
[[ "$DRY_RUN" == "1" ]] && VISION_DESCRIBE=""

if [[ -z "$PROMPT" ]]; then
  echo "Erro: prompt obrigatório. Use: h3 \"seu prompt\""
  echo "Ajuda: h3 --help"
  exit 1
fi

# ── Seed aleatório quando não passado (--seed N fixa explicitamente) ──────
# Mesmo range do Wan2GP (random.randint(0, 999999999) quando recebe seed<0).
# O valor sorteado aparece no summary, no dry-run e no filename ({seed}).
if [[ -z "$SEED" ]]; then
  SEED=$(python3 -c "import random; print(random.randint(0, 999999999))")
  SEED_SOURCE="aleatório"
else
  SEED_SOURCE="fixo (--seed)"
fi

# ── Resolver paths relativos para absolutos ──────────────────────────────
# O Wan2GP resolve paths relativos em relação ao próprio diretório (~/git/Wan2GP),
# não em relação ao cwd do usuário. Convertemos tudo pra absoluto aqui.
resolve_path() {
  local p="$1"
  [[ -z "$p" ]] && return 0
  # Expande ~ e resolve relativo ao cwd do usuário
  python3 -c "import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))" "$p"
}

IMAGE_START=$(resolve_path "$IMAGE_START")
IMAGE_END=$(resolve_path "$IMAGE_END")
REF_VIDEO=$(resolve_path "$REF_VIDEO")
REF_VIDEO2=$(resolve_path "$REF_VIDEO2")
REF_AUDIO=$(resolve_path "$REF_AUDIO")
REF_AUDIO2=$(resolve_path "$REF_AUDIO2")

# Resolver array de imagens
if [[ ${#REF_IMAGES[@]} -gt 0 ]]; then
  RESOLVED_REFS=()
  for img in "${REF_IMAGES[@]}"; do
    RESOLVED_REFS+=("$(resolve_path "$img")")
  done
  REF_IMAGES=("${RESOLVED_REFS[@]}")
fi

# Validar que arquivos existem
for f in "$IMAGE_START" "$IMAGE_END" "$REF_VIDEO" "$REF_VIDEO2" "$REF_AUDIO" "$REF_AUDIO2" "${REF_IMAGES[@]}"; do
  if [[ -n "$f" && ! -f "$f" ]]; then
    echo "Erro: arquivo não encontrado: $f"
    exit 1
  fi
done

# ── Redimensionar imagens grandes para /tmp ──────────────────────────────
# O Qwen3-VL text encoder converte imagens em patches de 32px (16 patch_size
# × 2 merge_size). Imagens grandes (ex: 4000×3000 = 12MP) geram ~46K tokens
# visuais cada, consumindo VRAM que pode causar OOM no text_encoder.
# Redimensionamos para no máximo MAX_IMAGE_MP megapixels, mantendo aspect ratio
# e alinhando ao fator 32. Imagens dentro do limite passam direto.
# Arquivos temporários ficam em /tmp (tmpfs) e são limpos ao final.
H3_TEMP_IMAGES=()
cleanup_temp_images() {
  for f in "${H3_TEMP_IMAGES[@]}"; do
    [[ -n "$f" && -f "$f" ]] && rm -f "$f"
  done
  # catálogo NSFW (mktemp h3_catalog_*): usado pelo enhance via env H3_CATALOG_FILE;
  # no EXIT o wgp já terminou — seguro apagar (antes ficava acumulado em /tmp)
  [[ -n "$CATALOG_FILE" && -f "$CATALOG_FILE" ]] && rm -f "$CATALOG_FILE"
  # settings JSON idem (02/out): dry-run interrompido por SIGPIPE (reader fecha o
  # pipe antes do rm) ou validação que morre c/ exit 1 não deixavam resíduo atrás
  [[ -n "${SETTINGS_FILE:-}" && -f "$SETTINGS_FILE" ]] && rm -f "$SETTINGS_FILE"
}
trap cleanup_temp_images EXIT

resize_image_if_needed() {
  local img_path="$1"
  [[ -z "$img_path" ]] && return 0

  local max_pixels
  max_pixels=$(python3 -c "print(int(float('$MAX_IMAGE_MP') * 1000000))")

  # Extrai dimensões com ffmpeg/ffprobe (fallback para PIL se necessário)
  local dims
  dims=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "$img_path" 2>/dev/null) || return 0
  [[ -z "$dims" ]] && return 0

  local w h
  w=$(echo "$dims" | cut -d'x' -f1)
  h=$(echo "$dims" | cut -d'x' -f2)

  local total_pixels=$((w * h))
  if (( total_pixels <= max_pixels )); then
    return 0  # Imagem dentro do limite, não redimensiona
  fi

  # Calcula novo tamanho mantendo aspect ratio, alinhado ao fator 32
  local RESIZED_OUT resized_path resized_w resized_h
  RESIZED_OUT=$(python3 -c "
import math, os, hashlib
w, h = $w, $h
max_px = $max_pixels
factor = 32  # patch_size(16) × merge_size(2)
# Calcular escala
scale = math.sqrt(max_px / (w * h))
new_w = max(factor, math.floor(w * scale / factor) * factor)
new_h = max(factor, math.floor(h * scale / factor) * factor)
# Garantir que não excede max_pixels
while new_w * new_h > max_px:
    if new_w >= new_h:
        new_w -= factor
    else:
        new_h -= factor
    if new_w < factor or new_h < factor:
        break
ext = os.path.splitext('$img_path')[1].lower()
if ext not in ('.jpg', '.jpeg', '.png', '.webp', '.bmp'):
    ext = '.jpg'
content_hash = hashlib.md5(os.path.abspath('$img_path').encode()).hexdigest()[:8]
print(f'/tmp/h3_resized_{content_hash}{ext}')
print(new_w)
print(new_h)
")
  resized_path=$(echo "$RESIZED_OUT" | sed -n '1p')
  resized_w=$(echo "$RESIZED_OUT" | sed -n '2p')
  resized_h=$(echo "$RESIZED_OUT" | sed -n '3p')

  # Se já existe (mesma imagem redimensionada antes), reutiliza
  if [[ -f "$resized_path" ]]; then
    echo "$resized_path"
    return 0
  fi

  echo "  Redimensionando: $(basename "$img_path") ${w}x${h} → ${resized_w}x${resized_h} (max ${MAX_IMAGE_MP}MP)" >&2
  if ! ffmpeg -y -i "$img_path" -vf "scale=${resized_w}:${resized_h}" -q:v 2 "$resized_path" 2>/dev/null; then
    echo "    Aviso: falha ao redimensionar, usando imagem original" >&2
    return 0
  fi

  echo "$resized_path"
}

# Aplicar resize em todas as imagens (FL2VA + Ref2VA)
if [[ -n "$IMAGE_START" ]]; then
  RESIZED=$(resize_image_if_needed "$IMAGE_START")
  if [[ -n "$RESIZED" ]]; then
    H3_TEMP_IMAGES+=("$RESIZED")
    IMAGE_START="$RESIZED"
  fi
fi
if [[ -n "$IMAGE_END" ]]; then
  RESIZED=$(resize_image_if_needed "$IMAGE_END")
  if [[ -n "$RESIZED" ]]; then
    H3_TEMP_IMAGES+=("$RESIZED")
    IMAGE_END="$RESIZED"
  fi
fi
if [[ ${#REF_IMAGES[@]} -gt 0 ]]; then
  RESOLVED_REFS=()
  for img in "${REF_IMAGES[@]}"; do
    RESIZED=$(resize_image_if_needed "$img")
    if [[ -n "$RESIZED" ]]; then
      H3_TEMP_IMAGES+=("$RESIZED")
      RESOLVED_REFS+=("$RESIZED")
    else
      RESOLVED_REFS+=("$img")
    fi
  done
  REF_IMAGES=("${RESOLVED_REFS[@]}")
fi

# ── Detectar modo ─────────────────────────────────────────────────────────
FL2VA_MODE=false
REF2VA_MODE=false

if [[ -n "$IMAGE_START" || -n "$IMAGE_END" ]]; then
  FL2VA_MODE=true
fi

if [[ ${#REF_IMAGES[@]} -gt 0 || -n "$REF_VIDEO" || -n "$REF_VIDEO2" || -n "$REF_AUDIO" || -n "$REF_AUDIO2" || "$USE_SOUNDTRACK" == true ]]; then
  REF2VA_MODE=true
fi

if [[ "$FL2VA_MODE" == true && "$REF2VA_MODE" == true ]]; then
  echo "Erro: FL2VA (--image-start/--image-end) e Ref2VA (--ref-img/--ref-video/--ref-audio) são mutuamente exclusivos."
  exit 1
fi

# ── Verificar que os modelos existem em disco ────────────────────────────
# O Wan2GP baixa modelos faltantes automaticamente, o que pode lotar o disco.
# Bloquear antes se não tiver o checkpoint.
CKPTS_DIR="$WAN2GP_DIR/ckpts"
if [[ "$W4A8" == true ]]; then
  # w4a8 experimental (Kijai): ~45% mais leve, ataca o OOM de --ref-video no 6GB.
  # Precisa do model def defaults/minimax_h3_ref2va_w4a8.json (criado 2026-09-01).
  if [[ "$REF2VA_MODE" == true ]]; then
    MODEL_FILE="$CKPTS_DIR/MiniMax-H3-Ref2VA-pruned_w4a8_mixed.safetensors"
  else
    echo "Erro: --w4a8 hoje só cobre Ref2VA (FL2VA w4a8 existe no Kijai mas não baixado)."
    exit 1
  fi
elif [[ "${H3_GGUF:-1}" == "1" ]]; then
  # Stack GGUF enxuta (29/09): Q4_K unsloth + TE Q3 abliterated + VAEs Abiray
  MODEL_FILE="$CKPTS_DIR/minimax_h3_ref2va_pruned-Q4_K.gguf"
  [[ "$REF2VA_MODE" != true ]] && MODEL_FILE="$CKPTS_DIR/minimax_h3_fl2va_pruned-Q4_K.gguf"
  TEXT_ENCODER="$CKPTS_DIR/Qwen3-VL-32B-Instruct/qwen3vl-32B-MiniMax-H3-Q4_K_M.gguf"
  VIDEO_VAE="$CKPTS_DIR/MiniMax-H3-video_vae_fp16.safetensors"
  AUDIO_VAE="$CKPTS_DIR/MiniMax-H3-audio_vae_fp32.safetensors"
elif [[ "$REF2VA_MODE" == true ]]; then
  MODEL_FILE="$CKPTS_DIR/MiniMax-H3-Ref2VA-pruned_int8_convrot.safetensors"
else
  MODEL_FILE="$CKPTS_DIR/MiniMax-H3-FL2VA-pruned_int8_convrot.safetensors"
  TEXT_ENCODER="$CKPTS_DIR/qwen3vl-32B-MiniMax-H3-Q4_K_M.gguf"
  VIDEO_VAE="$CKPTS_DIR/MiniMax-H3-video_vae_fp16.safetensors"
  AUDIO_VAE="$CKPTS_DIR/MiniMax-H3-audio_vae_fp32.safetensors"
fi
if [[ "${H3_GGUF:-1}" == "1" ]]; then :; fi
# (GGUF branch seta TEXT_ENCODER/VAEs completos; int8 legacy path idem)

for f in "$MODEL_FILE" "$TEXT_ENCODER" "$VIDEO_VAE" "$AUDIO_VAE"; do
  if [[ ! -e "$f" ]]; then
    echo "Erro: modelo não encontrado: $f"
    echo "Baixe manualmente antes de gerar. O Wan2GP tentaria baixar automaticamente"
    echo "e pode lotar o disco."
    exit 1
  fi
done

# ── Construir prompt types e model_type ──────────────────────────────────
if [[ "$REF2VA_MODE" == true ]]; then
  MODEL_TYPE="minimax_h3_ref2va_pruned"
[[ "${H3_GGUF:-1}" == "1" ]] && MODEL_TYPE="minimax_h3_ref2va_gguf"   # default: stack GGUF enxuta (H3_GGUF=0 volta pro int8)
  TASK_TYPE="ref2va"
  VIDEO_PROMPT_TYPE=""
  [[ ${#REF_IMAGES[@]} -gt 0 ]] && VIDEO_PROMPT_TYPE+="I"
  if [[ -n "$REF_VIDEO" && -n "$REF_VIDEO2" ]]; then
    VIDEO_PROMPT_TYPE+="V+G"
  elif [[ -n "$REF_VIDEO" ]]; then
    VIDEO_PROMPT_TYPE+="VG"
  fi
  AUDIO_PROMPT_TYPE=""
  if [[ "$USE_SOUNDTRACK" == true ]]; then
    AUDIO_PROMPT_TYPE="K"
  elif [[ -n "$REF_AUDIO" && -n "$REF_AUDIO2" ]]; then
    AUDIO_PROMPT_TYPE="AB"
  elif [[ -n "$REF_AUDIO" ]]; then
    AUDIO_PROMPT_TYPE="A"
  fi
  IMAGE_PROMPT_TYPE=""
elif [[ "$FL2VA_MODE" == true ]]; then
  MODEL_TYPE="minimax_h3_fl2va_pruned"
  [[ "${H3_GGUF:-1}" == "1" ]] && MODEL_TYPE="minimax_h3_fl2va_gguf"
  TASK_TYPE="i2v"
  IMAGE_PROMPT_TYPE=""
  [[ -n "$IMAGE_START" ]] && IMAGE_PROMPT_TYPE+="S"
  [[ -n "$IMAGE_END" ]] && IMAGE_PROMPT_TYPE+="E"
  VIDEO_PROMPT_TYPE=""
  AUDIO_PROMPT_TYPE=""
else
  MODEL_TYPE="minimax_h3_fl2va_pruned"
  [[ "${H3_GGUF:-1}" == "1" ]] && MODEL_TYPE="minimax_h3_fl2va_gguf"
  TASK_TYPE="t2v"
  IMAGE_PROMPT_TYPE=""
  VIDEO_PROMPT_TYPE=""
  AUDIO_PROMPT_TYPE=""
fi

# PDD: variantes de model type dedicadas (8 steps + Euler travados no pipeline)
[[ "$PDD" == true ]] && MODEL_TYPE="${MODEL_TYPE}_pdd"

# ── Validar Ref2VA: pelo menos 1 referência ──────────────────────────────
if [[ "$REF2VA_MODE" == true ]]; then
  VISUAL_COUNT=${#REF_IMAGES[@]}
  [[ -n "$REF_VIDEO" ]] && ((VISUAL_COUNT++))
  [[ -n "$REF_VIDEO2" ]] && ((VISUAL_COUNT++))
  if [[ "$USE_SOUNDTRACK" == true ]]; then
    AUDIO_COUNT=1  # soundtrack usa 1 slot por vídeo
  else
    AUDIO_COUNT=0
    [[ -n "$REF_AUDIO" ]] && ((AUDIO_COUNT++))
    [[ -n "$REF_AUDIO2" ]] && ((AUDIO_COUNT++))
  fi
  if [[ $VISUAL_COUNT -eq 0 && $AUDIO_COUNT -eq 0 ]]; then
    echo "Erro: Ref2VA requer pelo menos uma referência (imagem, vídeo ou áudio)."
    exit 1
  fi
  if [[ $AUDIO_COUNT -gt $VISUAL_COUNT ]]; then
    echo "Erro: Ref2VA requer pelo menos tantas referências visuais (imgs+vídeos=$VISUAL_COUNT) quanto áudios ($AUDIO_COUNT)."
    exit 1
  fi
  if [[ "$USE_SOUNDTRACK" == true && -z "$REF_VIDEO" && -z "$REF_VIDEO2" ]]; then
    echo "Erro: --use-soundtrack requer pelo menos um --ref-video."
    exit 1
  fi
fi

# ── Prompt enhancement ──────────────────────────────────────────────────
# O LLM não recebe as imagens/vídeos/áudios em si. Ele recebe o prompt do
# usuário + um contexto estruturado dizendo quantos de cada tipo foram
# passados e em qual modo (first-frame vs referência). O LLM usa isso pra
# escrever o prompt H3 com os labels corretos (<Picture N>, <Video N>,
# <Audio N>) sem mudar a semântica do que o usuário pediu.
# Aviso: --vision-with só tem efeito com --enhance (vision describe roda no fluxo de enhance)
if [[ -n "$VLM_MODEL_OVERRIDE" && "$ENHANCE" != true && "$DRY_RUN" != "1" ]]; then
  echo "Aviso: --vision-with precisa de --enhance pra surtir efeito (a descrição visual roda dentro do fluxo de enhance). Ignorando."
fi
# Com --enhance-with-vision o describe separado não roda; overrides dele não têm efeito
if [[ "$ENHANCE_WITH_VISION" == true ]]; then
  [[ -n "$VLM_MODEL_OVERRIDE" ]] && echo "Aviso: --vision-with não tem efeito com --enhance-with-vision (não há vision describe separado). Ignorando."
  [[ "$VISION_DESCRIBE" == false ]] && echo "Aviso: --no-vision-describe redundante com --enhance-with-vision (describe já é pulado)."
fi
if [[ "$ENHANCE" == true ]]; then
  if [[ -z "$ENHANCE_MODEL" ]]; then
    ENHANCE_MODEL="$ENHANCE_DEFAULT"
  fi

  # Detectar prefixo ollama: e trocar endpoint
  ENHANCE_URL="$LLAMA_SWAP_URL"
  if [[ "$ENHANCE_MODEL" == ollama:* ]]; then
    ENHANCE_MODEL="${ENHANCE_MODEL#ollama:}"
    ENHANCE_URL="$OLLAMA_URL"
    echo "=== Enhance via Ollama: $ENHANCE_MODEL (porta 11434) ==="
  fi

  # ── NSFW nova rota (29/09): catálogo com IDs no system + linha LORAS: exigida ──
  # force-nsfw-loras presente = LLM NEM VÊ o catálogo (lista do user é lei)
  # 30/09: catálogo PRÉ-RANKED pelo ColBERT hibrído (rerank_catalog.py) — colbert morto = catálogo completo (fail-open)
  CATALOG_SYSTEM=""
  if [[ "$NSFW" == true && -z "$FORCE_NSFW_LORA_IDS" && -f "$NSFW_CATALOG_JSON" ]]; then
    CATALOG_TEXT=$(python3 "$HOME/.local/share/h3/rerank_catalog.py" --prompt "$PROMPT" --n 12 --mode both 2>>"$HOME/.local/share/h3/.colbert_shadow.log")
    # both: stdout = catálogo reordenado; stderr = linha de auditoria .colbert_shadow.log
    if [[ -z "$CATALOG_TEXT" ]]; then
      CATALOG_TEXT=$(python3 "$HOME/.local/share/h3/build_catalog_prompt.py" 2>/dev/null)
    fi
    CATALOG_SYSTEM=$(cat <<'CATBLOCK'

--- LoRA selection ---
You are choosing action LoRAs from the catalog below to match the scene the user requested. The catalog lists ALL available LoRAs: a ranked section first (most relevant to this request, with relevance scores) and every remaining LoRA after it — scan BOTH sections before deciding. Catalog:

CATALOG_PLACEHOLDER

Selection rules:
- Read the user's request as INTENT. If the request mentions an outcome (gozada, ejaculação, facial, oral
- MODALIDADE: se o bloco de modalidade abaixo indicar ref2va (refs ativas), PREFIRA LoRAs marcados com o tag [REF2VA] na descrição — eles são treinados com referências e preservam identidade. LoRAs marcados [REF2VA] em run SEM refs tendem a falhar. Em run com refs, LoRAs de ação genérica (sem tag) ainda funcionam, mas o tag indica treino especializado pra esse caso.
- Multi-LoRA is normal in complex scenes (typically 2-3: one for the position/action, one for anatomy rei
- Trigger words from chosen LoRAs are injected automatically by the system — never write them in the para

After the enhanced paragraph, on the LAST line, output exactly: LORAS: <comma-separated IDs>
If genuinely nothing fits the request, output: LORAS: none
Never mention catalog trigger words in the paragraph itself.
MODALITY_NOTICE
CATBLOCK
)
    # injeção do catálogo real (placeholder → texto)
    CATALOG_SYSTEM="${CATALOG_SYSTEM//CATALOG_PLACEHOLDER/$CATALOG_TEXT}"
    # Aviso de modalidade (o enhance vê refs ativas e prefere LoRAs [REF2VA] no catálogo)
    if [[ "${REF2VA_MODE:-}" == true ]]; then
      MODALITY_TEXT="Current generation modality: ref2va (reference frames/videos ACTIVE: identity comes from the provided refs). Prefer LoRAs tagged [REF2VA] in the catalog — they are trained for reference runs and preserve identity."
    else
      MODALITY_TEXT="Current generation modality: fl2va (text-to-video, NO reference images/videos). Do NOT pick LoRAs tagged [REF2VA] — they are trained for reference runs and underperform without refs."
    fi
    CATALOG_SYSTEM="${CATALOG_SYSTEM//MODALITY_NOTICE/$MODALITY_TEXT}"
    CATALOG_FILE=$(mktemp /tmp/h3_catalog_XXXX.txt)
    printf '%s\n' "$CATALOG_SYSTEM" > "$CATALOG_FILE"
    echo "=== Catalogo NSFW salvo: $CATALOG_FILE (${#CATALOG_SYSTEM} chars) ==="
  fi
  # Escolher system prompt: NSFW simplificado quando --nsfw, completo caso contrário
  if [[ "$NSFW" == true ]]; then
    if [[ "$REF2VA_MODE" == true ]]; then
      SYSTEM_PROMPT_VAR="NSFW_REF2VA_TEXT_SYSTEM_PROMPT"
    else
      SYSTEM_PROMPT_VAR="NSFW_FL2VA_TEXT_SYSTEM_PROMPT"
    fi
  else
    if [[ "$REF2VA_MODE" == true ]]; then
      SYSTEM_PROMPT_VAR="REF2VA_TEXT_SYSTEM_PROMPT"
    else
      SYSTEM_PROMPT_VAR="FL2VA_TEXT_SYSTEM_PROMPT"
    fi
  fi

  # Construir contexto de mídia para anexar ao prompt do usuário
  MEDIA_CONTEXT=""
  if [[ "$NSFW" == true ]]; then
    # NSFW: contexto simplificado — sem timestamps, sem seções estruturadas.
    # MAS mantém os labels <Picture N>: o text encoder do H3 expõe cada imagem
    # no contexto como "<Picture N>:" e o pipeline só ancora a identidade de
    # cada pessoa se o prompt citar o label dela (text_encoder.py _presentation;
    # bug 03-04/09: com 2 refs e prompt flat sem labels, a 2ª pessoa saía
    # irreconhecível). Newlines REAIS ($'\n') — "\n" em aspas duplas é literal.
    DURATION_SEC=$(python3 -c "print(f'{$FRAMES / 24:.1f}')")
    MEDIA_CONTEXT="[Output duration: ${DURATION_SEC} seconds]"$'\n'
    if [[ "$FL2VA_MODE" == true ]]; then
      MEDIA_CONTEXT+="[Mode: First-Last Frame to Video]"$'\n'
      PIC_COUNT=0
      if [[ -n "$IMAGE_START" ]]; then
        ((PIC_COUNT++))
        MEDIA_CONTEXT+="<Picture 1> is the first frame of the output video."$'\n'
      fi
      if [[ -n "$IMAGE_END" ]]; then
        ((PIC_COUNT++))
        if [[ $PIC_COUNT -eq 2 ]]; then
          MEDIA_CONTEXT+="<Picture 2> is the last frame of the output video."$'\n'
        else
          MEDIA_CONTEXT+="<Picture 1> is the last frame of the output video."$'\n'
        fi
      fi
    elif [[ "$REF2VA_MODE" == true ]]; then
      PIC_COUNT=${#REF_IMAGES[@]}
      VID_COUNT=0; [[ -n "$REF_VIDEO" ]] && ((VID_COUNT++)); [[ -n "$REF_VIDEO2" ]] && ((VID_COUNT++))
      MEDIA_CONTEXT+="[Mode: Reference to Video]"$'\n'
      if [[ $PIC_COUNT -gt 0 ]]; then
        MEDIA_CONTEXT+="<Picture 1> through <Picture $PIC_COUNT>: reference image(s) provided for appearance guidance."$'\n'
      fi
      if [[ $PIC_COUNT -gt 1 ]]; then
        MEDIA_CONTEXT+="If the reference images depict different people or subjects, anchor each one's appearance to their own label exactly once (<Picture 1> = first supplied image, <Picture 2> = second)."$'\n'
        MEDIA_CONTEXT+="A reference image may itself be a COLLAGE of multiple photos (multiple poses, angles, or outfits in one file). If a description starts with 'This is a collage', treat each described panel as a separate sub-reference of that same <Picture N>: pick the panel(s) that match the requested subject and use only those panels' appearance, never blending different panels into one subject and never reproducing the collage layout as a scene."$'\n'
      fi
      if [[ $VID_COUNT -gt 0 ]]; then
        if [[ $VID_COUNT -gt 1 ]]; then
          MEDIA_CONTEXT+="<Video 1> through <Video 2>: reference video(s)."$'\n'
        else
          MEDIA_CONTEXT+="<Video 1>: reference video."$'\n'
        fi
      fi
    fi
  elif [[ "$FL2VA_MODE" == true ]]; then
    # Calcula duração em segundos (24fps)
    DURATION_SEC=$(python3 -c "print(f'{$FRAMES / 24:.1f}')")
    MEDIA_CONTEXT="[Generation mode: First-Last Frame to Video and Audio (FL2VA)]\n[Output duration: ${DURATION_SEC} seconds ($FRAMES frames at 24fps). All timestamps in the prompt must fall within 0.00–${DURATION_SEC}s.]\n"
    PIC_COUNT=0
    if [[ -n "$IMAGE_START" ]]; then
      ((PIC_COUNT++))
      MEDIA_CONTEXT+="<Picture 1> is the first frame of the output video at 0.00 seconds.\n"
    fi
    if [[ -n "$IMAGE_END" ]]; then
      ((PIC_COUNT++))
      if [[ $PIC_COUNT -eq 2 ]]; then
        MEDIA_CONTEXT+="<Picture 2> is the last frame of the output video, aligning with the exact end time (${DURATION_SEC}s).\n"
      else
        MEDIA_CONTEXT+="<Picture 1> is the last frame of the output video, aligning with the exact end time (${DURATION_SEC}s).\n"
      fi
    fi
    MEDIA_CONTEXT+="Total boundary images: $PIC_COUNT.\n"
  elif [[ "$REF2VA_MODE" == true ]]; then
    # Calcula duração em segundos (24fps)
    DURATION_SEC=$(python3 -c "print(f'{$FRAMES / 24:.1f}')")
    MEDIA_CONTEXT="[Generation mode: Reference to Video and Audio (Ref2VA)]\n[Output duration: ${DURATION_SEC} seconds ($FRAMES frames at 24fps). All timestamps in the prompt must fall within 0.00–${DURATION_SEC}s.]\n"
    PIC_COUNT=${#REF_IMAGES[@]}
    VID_COUNT=0
    [[ -n "$REF_VIDEO" ]] && ((VID_COUNT++))
    [[ -n "$REF_VIDEO2" ]] && ((VID_COUNT++))
    AUD_COUNT=0
    if [[ "$USE_SOUNDTRACK" == true ]]; then
      AUD_COUNT=$VID_COUNT  # soundtrack usa 1 slot por vídeo
      MEDIA_CONTEXT+="Audio: using soundtrack(s) from $VID_COUNT reference video(s).\n"
    else
      [[ -n "$REF_AUDIO" ]] && ((AUD_COUNT++))
      [[ -n "$REF_AUDIO2" ]] && ((AUD_COUNT++))
    fi
    if [[ $PIC_COUNT -gt 0 ]]; then
      MEDIA_CONTEXT+="<Picture 1> through <Picture $PIC_COUNT>: $PIC_COUNT reference image(s) (general reference assets, not output keyframes unless the user explicitly requests it).\n"
    fi
    if [[ $VID_COUNT -gt 0 ]]; then
      MEDIA_CONTEXT+="<Video 1"$( [[ $VID_COUNT -gt 1 ]] && echo " through <Video $VID_COUNT" )">: $VID_COUNT reference video(s) (contextual material for motion, appearance, or content guidance; not a guaranteed frame-exact continuation unless the user explicitly requests continuation).\n"
    fi
    if [[ $AUD_COUNT -gt 0 ]] && [[ "$USE_SOUNDTRACK" != true ]]; then
      MEDIA_CONTEXT+="<Audio 1"$( [[ $AUD_COUNT -gt 1 ]] && echo " through <Audio $AUD_COUNT" )">: $AUD_COUNT reference audio clip(s) (2-15 seconds each, for voice, music, rhythm, or effects guidance).\n"
    fi
    MEDIA_CONTEXT+="Total reference files: $((PIC_COUNT + VID_COUNT + AUD_COUNT)) (images: $PIC_COUNT, videos: $VID_COUNT, audio: $AUD_COUNT).\n"
    MEDIA_CONTEXT+="Requirements: at least as many visual references (images+videos=$((PIC_COUNT + VID_COUNT))) as audio references ($AUD_COUNT).\n"
  else
    # Calcula duração em segundos (24fps)
    DURATION_SEC=$(python3 -c "print(f'{$FRAMES / 24:.1f}')")
    MEDIA_CONTEXT="[Generation mode: Text to Video and Audio (T2V) — no input images, videos, or audio]\n[Output duration: ${DURATION_SEC} seconds ($FRAMES frames at 24fps). All timestamps in the prompt must fall within 0.00–${DURATION_SEC}s.]\n"
  fi

  # ── Vision describe: descrever imagens via VLM antes do enhance ──────────
  # O LLM de enhance não vê as imagens. O VLM (qwen3-vl-4b) lê cada imagem
  # e produz uma descrição detalhada que é injetada no media context, dando
  # ao LLM de enhance informação visual concreta sobre cores, composição,
  # sujeitos, iluminação, etc.
  # --enhance-with-vision (coringa): o próprio LLM de enhance tem vision
  # (mmproj) e recebe as imagens inline — pula o describe separado.
  VISION_DESCRIPTIONS=""
  H3_VISION_DESCRIBE_WANT="${VISION_DESCRIBE}"
# dry-run zera VISION_DESCRIBE (side-effect) mas o auto-despacho é só um check de capability
if [[ "$DRY_RUN" == "1" ]]; then H3_VISION_DESCRIBE_WANT=true; fi
if [[ "$ENHANCE" == true && "$ENHANCE_WITH_VISION" != true && "$H3_VISION_DESCRIBE_WANT" == true ]]; then
    # AUTO-DESPACHO (29/09): se o enhance LLM vê imagens, inline direto (sem especialista).
    H3_HAS_IMAGES=false
